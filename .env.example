# Bisque environment variables (BYOK — bring your own keys)
# Copy this file to .env and fill in your values. Never commit .env.

# Model API keys (at least one required; can also be configured via /login)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# Radius gateway (supported natively)
RADIUS_API_KEY=
PI_RADIUS_GATEWAY=

# Optional: offline mode (1 = disable model catalog network refresh)
PI_OFFLINE=
