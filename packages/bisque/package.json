{
	"name": "@earendil-works/bisque",
	"private": true,
	"version": "0.1.0",
	"description": "Bisque plain-language coworker CLI built on pi-coding-agent",
	"type": "module",
	"bin": {
		"bisque": "./dist/cli.js"
	},
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"source": "./src/index.ts",
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"skills",
		"prompts",
		"README.md"
	],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"clean": "node ../../scripts/package-files.mjs clean dist",
		"build": "tsc -p tsconfig.build.json && node ../../scripts/package-files.mjs executable dist/cli.js",
		"test": "vitest --run"
	},
	"dependencies": {
		"@earendil-works/pi-agent-core": "workspace:*",
		"@earendil-works/pi-ai": "workspace:*",
		"@earendil-works/pi-coding-agent": "workspace:*",
		"@earendil-works/pi-tui": "workspace:*",
		"@xenova/transformers": "2.17.1",
		"typebox": "1.3.27"
	},
	"devDependencies": {
		"typescript": "7.0.2",
		"vitest": "4.1.12"
	}
}
